rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isAdmin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));}
  function isOwner(uid){return signedIn() && request.auth.uid == uid;}
  function validString(value,minimum,maximum){return value is string && value.size() >= minimum && value.size() <= maximum;}
  function validStatus(s){return s in ['pending','confirmed','completed','cancelled'];}
  match /admins/{uid} {
   allow get: if isOwner(uid);
   allow list,create,update,delete: if false;
  }
  match /driversPublic/{uid} {
   allow get: if true;
   allow list: if isAdmin();
   allow create: if isOwner(uid)
    && request.resource.data.keys().hasOnly(['displayName','taxiName','phone','city','vehicle','accent','status','active','createdAt'])
    && request.resource.data.keys().hasAll(['displayName','taxiName','phone','city','vehicle','accent','status','active','createdAt'])
    && validString(request.resource.data.displayName,2,80)
    && validString(request.resource.data.taxiName,2,80)
    && validString(request.resource.data.phone,7,30)
    && validString(request.resource.data.city,2,70)
    && validString(request.resource.data.vehicle,0,100)
    && validString(request.resource.data.accent,7,7)
    && request.resource.data.status == 'pending'
    && request.resource.data.active == false
    && request.resource.data.createdAt == request.time;
   allow update: if isAdmin() || (
    isOwner(uid)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','taxiName','phone','city','vehicle','accent','updatedAt'])
    && validString(request.resource.data.displayName,2,80)
    && validString(request.resource.data.taxiName,2,80)
    && validString(request.resource.data.phone,7,30)
    && validString(request.resource.data.city,2,70)
    && validString(request.resource.data.vehicle,0,100)
    && validString(request.resource.data.accent,7,7)
    && request.resource.data.updatedAt == request.time
   );
   allow delete: if false;
  }
  match /reservations/{bookingId} {
   allow create: if request.resource.data.keys().hasOnly(['driverId','passengerName','passengerPhone','pickup','dropoff','datetime','passengers','note','status','createdAt'])
    && request.resource.data.keys().hasAll(['driverId','passengerName','passengerPhone','pickup','dropoff','datetime','passengers','note','status','createdAt'])
    && validString(request.resource.data.driverId,2,130)
    && exists(/databases/$(database)/documents/driversPublic/$(request.resource.data.driverId))
    && get(/databases/$(database)/documents/driversPublic/$(request.resource.data.driverId)).data.active == true
    && get(/databases/$(database)/documents/driversPublic/$(request.resource.data.driverId)).data.status == 'approved'
    && validString(request.resource.data.passengerName,2,100)
    && validString(request.resource.data.passengerPhone,7,30)
    && validString(request.resource.data.pickup,3,180)
    && validString(request.resource.data.dropoff,3,180)
    && validString(request.resource.data.datetime,16,16)
    && request.resource.data.datetime.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
    && request.resource.data.passengers is int
    && request.resource.data.passengers >= 1
    && request.resource.data.passengers <= 6
    && validString(request.resource.data.note,0,500)
    && request.resource.data.status == 'pending'
    && request.resource.data.createdAt == request.time;
   allow get,list: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid);
   allow update: if (isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid))
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
    && validStatus(request.resource.data.status)
    && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  match /{document=**} {allow read,write: if false;}
 }
}